# ── Supabase ────────────────────────────────────────────────────────
# Project region MUST be ap-south-1 (Mumbai). Region migration means
# downtime and a full data move — decide once, at project creation.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefixed NEXT_PUBLIC_. Never imported by a client
# component. CI fails the build if this string appears outside
# src/lib/supabase/admin.ts or supabase/functions/.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LAUNCH_CITY=Pune

# ── Not yet wired (later phases) ────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KYC_PROVIDER_API_KEY=
# WHATSAPP_BSP_TOKEN=
